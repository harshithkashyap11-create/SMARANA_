# PostgreSQL
POSTGRES_DB=smarana
POSTGRES_USER=smarana
POSTGRES_PASSWORD=smarana_dev

# MinIO
MINIO_ROOT_USER=smarana
MINIO_ROOT_PASSWORD=smarana_dev_password
MINIO_BUCKET=smarana-media
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application
DJANGO_SECRET_KEY=development-only-change-me-at-least-32-bytes
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional local intelligence. Install/pull the model separately; Docker must use
# a reachable Ollama host instead of its container's loopback address.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen2.5:1.5b
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_TIMEOUT=8
# Enables the frontend hybrid endpoint (local model first).
VITE_VOICE_LLM_FALLBACK=1
VITE_VOICE_DEBUG=0
# Remote fallback uses the existing JSON router contract; opt in explicitly.
VOICE_LLM_FALLBACK=false
VOICE_ROUTER_ENDPOINT=
VOICE_ROUTER_TOKEN=
